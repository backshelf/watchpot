{
  "name": "orbital-orchard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun dev.ts",
    "build": "bun build ./index.html --outdir dist --production --sourcemap=linked",
    "typecheck": "bun check",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "test:changed": "bun test --changed=main --pass-with-no-tests",
    "test:slow": "bun test --path-ignore-patterns=\"**/node_modules/**\" .slow.test",
    "tokens": "bun design/build-tokens.ts",
    "sim": "bun sim/run.ts",
    "desk": "watchpot sim",
    "bench": "bun sim/bench.ts",
    "verify": "bun run typecheck && bun run lint && bun run test:changed",
    "gates": "bun run typecheck && bun run lint && bun test && bun run build",
    "gates:full": "bun run gates && bun run test:slow && bun run sim -- --contract"
  },
  "dependencies": {
    "watchpot": "workspace:*",
    "@number-flow/react": "0.6.2",
    "break_eternity.js": "2.1.3",
    "canvas-confetti": "1.9.4",
    "immer": "11.2.9",
    "motion": "14.7.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16",
    "zzfx": "1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@happy-dom/global-registrator": "^21.0.4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^7.0.2"
  }
}
