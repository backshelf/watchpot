{
  "name": "{{slug}}",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "bun": ">=1.4.3" },
  "scripts": {
    "dev": "bun dev.ts",
    "build": "bun build ./index.html --outdir dist --production --sourcemap=linked",
    "typecheck": "bun check",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "verify": "bun run typecheck && bun run lint",
    "gates": "bun run typecheck && bun run lint && bun run build"
  },
  "dependencies": {
    "watchpot": "git+ssh://github.com/backshelf/watchpot.git#{{engine}}",
    "break_eternity.js": "2.1.3",
    "immer": "11.2.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "^1.4.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^7.0.2"
  }
}
