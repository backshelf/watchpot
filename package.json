{
  "name": "watchpot",
  "version": "0.18.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.3"
  },
  "files": [
    "src",
    "api",
    "docs",
    "templates",
    "codemods",
    "env.d.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "workspaces": [
    "examples/*",
    "site"
  ],
  "scripts": {
    "typecheck": "bun check",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "test:changed": "bun test --changed=main --pass-with-no-tests",
    "test:slow": "bun test --pass-with-no-tests --path-ignore-patterns=\"**/node_modules/**\" .slow.test",
    "api": "bun scripts/api-report.ts",
    "api:check": "bun scripts/api-report.ts check",
    "dsp": "bun scripts/dsp.ts",
    "dsp:test": "cargo test --release --manifest-path dsp/Cargo.toml",
    "verify": "bun run typecheck && bun run lint && bun run test:changed && bun test test/rules",
    "gates": "bun run typecheck && bun run lint && bun run api:check && bun test",
    "gates:full": "bun run gates && bun run test:slow",
    "site:dev": "bun site/dev.ts",
    "site:build": "bun site/build.ts"
  },
  "exports": {
    "./core": "./src/core/index.ts",
    "./sim": "./src/sim/index.ts",
    "./test": "./src/test/index.ts",
    "./react": "./src/react/index.ts",
    "./devtools": "./src/devtools/index.ts",
    "./kit": "./src/kit/index.ts",
    "./sound": "./src/sound/index.ts",
    "./sound/pack": "./src/sound/pack/index.ts",
    "./three": "./src/three/index.ts",
    "./ui": "./src/ui/index.ts",
    "./shader": "./src/shader/index.ts",
    "./kit/theme": "./src/kit/theme/build.ts"
  },
  "peerDependencies": {
    "@number-flow/react": "^0.6.2",
    "break_eternity.js": "^2.1.3",
    "canvas-confetti": "^1.9.4",
    "immer": "^11.2.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16",
    "zzfx": "^1.4.0",
    "@testing-library/react": "^16.3.3",
    "three": "^0.187.0",
    "@react-three/fiber": "^9.8.2"
  },
  "peerDependenciesMeta": {
    "@number-flow/react": {
      "optional": true
    },
    "canvas-confetti": {
      "optional": true
    },
    "zzfx": {
      "optional": true
    },
    "@testing-library/react": {
      "optional": true
    },
    "three": {
      "optional": true
    },
    "@react-three/fiber": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@happy-dom/global-registrator": "^21.0.4",
    "@number-flow/react": "0.6.2",
    "@react-three/fiber": "9.8.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.187.0",
    "break_eternity.js": "2.1.3",
    "canvas-confetti": "1.9.4",
    "immer": "11.2.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "typescript": "^7.0.2",
    "zustand": "5.0.16",
    "zzfx": "1.4.0"
  }
}
